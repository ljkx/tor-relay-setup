root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# shfmt reads these keys.
[{*.sh,*.bash,*.bats}]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true
space_redirects = true

[Makefile]
indent_style = tab
