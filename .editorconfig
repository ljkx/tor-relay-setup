root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[{*.go,go.mod,Makefile}]
indent_style = tab

[*.{yml,yaml,toml}]
indent_style = space
indent_size = 2

# shfmt reads these keys.
[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true
space_redirects = true
